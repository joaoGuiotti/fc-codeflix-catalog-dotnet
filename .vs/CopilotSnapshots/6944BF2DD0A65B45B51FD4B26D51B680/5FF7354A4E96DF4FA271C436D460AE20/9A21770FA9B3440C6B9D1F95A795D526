namespace FC.Codeflix.Catalog.UnitTests.Domain.Entity.Category;

using FC.Codeflix.Catalog.Domain.Exceptions;
using FluentAssertions;
using DomainEntity = Catalog.Domain.Entity;

public class CategoryTest
{
    [Fact(DisplayName = nameof(Instantiate))]
    [Trait("Domain", "Category - Aggregates")]
    public void Instantiate()
    {
        var validaData = new
        {
            Name = "Category name",
            Description = "Category description"
        };

        var dateTimeBefore = DateTime.Now;
        var category = DomainEntity.Category.Create(validaData.Name, validaData.Description);
        var dateTimeAfter = DateTime.Now;

        category.Should().NotBeNull();
        category.Name.Should().Be(validaData.Name);
        category.Description.Should().Be(validaData.Description);
        category.Id.Should().NotBe(default(Guid));
        category.CreatedAt.Should().NotBe(default(DateTime));
        category.CreatedAt.Should().BeAfter(dateTimeBefore);
        category.CreatedAt.Should().BeBefore(dateTimeAfter);
        category.IsActive.Should().Be(true);
    }

    [Theory(DisplayName = nameof(InstantiateWithIsActive))]
    [Trait("Domain", "Category - Aggregates")]
    [InlineData(true)]
    [InlineData(false)]
    public void InstantiateWithIsActive(bool isActive)
    {
        var validaData = new
        {
            Name = "Category name",
            Description = "Category description"
        };

        var dateTimeBefore = DateTime.Now;
        var category = DomainEntity.Category.Create(validaData.Name, validaData.Description, isActive);
        var dateTimeAfter = DateTime.Now;

        Assert.NotNull(category);
        Assert.Equal(validaData.Name, category.Name);
        Assert.Equal(validaData.Description, category.Description);
        Assert.NotEqual(default(Guid), category.Id);
        Assert.NotEqual(default(DateTime), category.CreatedAt);
        Assert.True(category.CreatedAt > dateTimeBefore);
        Assert.True(category.CreatedAt < dateTimeAfter);
        Assert.Equal(isActive, category.IsActive);
    }

    [Theory(DisplayName = nameof(ThrowWhenNameIsEmptyOrNull))]
    [Trait("Domain", "Category - Aggregates")]
    [InlineData("")]
    [InlineData("  ")]
    [InlineData(null)]
    public void ThrowWhenNameIsEmptyOrNull(string name)
    {
        Action action = () => DomainEntity.Category.Create(name!, "Category Description");
        var exception = Assert.Throws<EntityValidationException>(action);
        Assert.Equal("Name cannot be null or empty.", exception.Message);
    }

    [Theory(DisplayName = nameof(ThrowWhenDescriptionIsEmptyOrNull))]
    [Trait("Domain", "Category - Aggregates")]
    [InlineData("")]
    [InlineData("  ")]
    [InlineData(null)]
    public void ThrowWhenDescriptionIsEmptyOrNull(string description)
    {
        Action action = () => DomainEntity.Category.Create("Category Name", description!);
        var exception = Assert.Throws<EntityValidationException>(action);
        Assert.Equal("Description cannot be null or empty.", exception.Message);
    }

    [Theory(DisplayName = nameof(ThrowWhenNameIsLessThanThreeCharacters))]
    [Trait("Domain", "Category - Aggregates")]
    [InlineData("ab")]
    [InlineData("a")]
    public void ThrowWhenNameIsLessThanThreeCharacters(string name)
    {
        Action action = () => DomainEntity.Category.Create(name, "Category Description");
        var exception = Assert.Throws<EntityValidationException>(action);
        Assert.Equal("Name must be at least 3 characters long.", exception.Message);
    }

    [Fact(DisplayName = nameof(ThrowWhenNameisGreaterThan255Characters))]
    [Trait("Domain", "Category - Aggregates")]
    public void ThrowWhenNameisGreaterThan255Characters()
    {
        var invalidName = String.Join(null, Enumerable.Range(0, 256).Select(_ => "a"));
        var exception = Assert.Throws<EntityValidationException>(() =>
        {
            DomainEntity.Category.Create(invalidName, "Description");
        });

        Assert.Equal("Name must be less or equal 255 characters.", exception.Message);
    }

    [Fact(DisplayName = nameof(Activate))]
    [Trait("Domain", "Category - Aggregates")]
    public void Activate()
    {
        var category = DomainEntity.Category.Create("Category Name", "Category Description", false);
        category.Activate();
        Assert.True(category.IsActive);
    }

    [Fact(DisplayName = nameof(Deactivate))]
    [Trait("Domain", "Category - Aggregates")]
    public void Deactivate()
    {
        var category = DomainEntity.Category.Create("Category Name", "Category Description", true);
        category.Deactivate();
        Assert.False(category.IsActive);
    }

    [Fact(DisplayName = nameof(Update))]
    [Trait("Domain", "Category - Aggregates")]
    public void Update()
    {
        var category = DomainEntity.Category.Create("Category Name", "Category Description");
        var newValues = new { Name = "Updated Name", Description = "Updated Description" };

        category.Update(newValues.Name, newValues.Description);

        Assert.Equal(newValues.Name, category.Name);
        Assert.Equal(newValues.Description, category.Description);
    }

    [Fact]
    [Trait("Domain", "Category - Aggregates")]
    public void UpdateOnlyName()
    {
        var category = DomainEntity.Category.Create("Category Name", "Category Description");
        var newName = "Updated Name";

        category.Update(newName);

        Assert.Equal(newName, category.Name);
        Assert.Equal("Category Description", category.Description);
    }

    [Fact]
    [Trait("Domain", "Category - Aggregates")]
    public void ThrowErrorWhenUpdateWithEmptyName()
    {
        var category = DomainEntity.Category.Create("Category Name", "Category Description");
        Action action = () => category.Update(string.Empty);
        var exception = Assert.Throws<EntityValidationException>(action);
        Assert.Equal("Name cannot be null or empty.", exception.Message);
        exception = Assert.Throws<EntityValidationException>(()
            => category.Update("  ", "New Description"));
        Assert.Equal("Name cannot be null or empty.", exception.Message);
    }

}
