{
  "profiles": {
    "FC.Codeflix.Catalog.Api": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "GOOGLE_APPLICATION_CREDENTIALS": "gcp_credentials.json"
      },
      "applicationUrl": "https://localhost:7097;http://localhost:5097",
      "dotnetRunMessages": true
    },
    "http": {
      "commandName": "Project",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "DevLocal",
        "GOOGLE_APPLICATION_CREDENTIALS": "gcp_credentials.json"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5195"
    },
    "https": {
      "commandName": "Project",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "GOOGLE_APPLICATION_CREDENTIALS": "gcp_credentials.json"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7141;http://localhost:5195"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080",
        "GOOGLE_APPLICATION_CREDENTIALS": "gcp_credentials.json"
      },
      "publishAllPorts": false,
      "useSSL": true,
      "DockerfileRunArguments": "--network service_catalog"
    }
  },
  "$schema": "https://json.schemastore.org/launchsettings.json"
}
